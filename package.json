{
  "author": "Nando Vieira <me@fnando.com>",
  "dependencies": {
    "bignumber.js": "^11.1.5",
    "es-toolkit": "^1.52.0",
    "make-plural": "^7.5.0"
  },
  "description": "A small library to provide I18n on JavaScript.",
  "devDependencies": {
    "@arethetypeswrong/cli": "*",
    "@biomejs/biome": "*",
    "@fnando/codestyle": "*",
    "@vitest/coverage-v8": "*",
    "esbuild": "*",
    "typescript": "^7.0.2",
    "vitest": "*"
  },
  "files": [
    "dist/**/*",
    "json/**/*",
    "src/**/*"
  ],
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/require/index.js",
  "module": "./dist/import/index.js",
  "types": "./dist/require/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/import/index.d.ts",
        "default": "./dist/import/index.js"
      },
      "require": {
        "types": "./dist/require/index.d.ts",
        "default": "./dist/require/index.js"
      }
    },
    "./json/*.json": "./json/*.json",
    "./package.json": "./package.json"
  },
  "name": "i18n-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fnando/i18n.git"
  },
  "scripts": {
    "build": "npm run clean && npm run build:js",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=I18n --minify --sourcemap --outfile=dist/browser/index.js",
    "build:import": "tsc --outDir ./dist/import --module ESNext && npm run build:import:pkg",
    "build:import:pkg": "node -e \"require('fs').writeFileSync('dist/import/package.json', JSON.stringify({ type: 'module' }, null, 2) + '\\n')\"",
    "build:js": "npm run build:import && npm run build:require && npm run build:browser",
    "build:require": "tsc --outDir ./dist/require --module commonjs",
    "check:exports": "attw --pack .",
    "clean": "rm -rf ./dist",
    "lint": "npm run lint:typescript && npm run lint:biome",
    "lint:biome": "biome check src",
    "lint:typescript": "tsc --noEmit",
    "test": "vitest --coverage",
    "test:ci": "vitest run --coverage && npm run lint && npm run build && npm run check:exports && npm run test:integration && npm run test:integration:react-native",
    "test:integration": "npm run test:integration:esm && npm run test:integration:cjs && npm run test:integration:browser",
    "test:integration:browser": "node integration/browser/validate.mjs",
    "test:integration:cjs": "node integration/cjs/index.cjs",
    "test:integration:esm": "node integration/esm/index.mjs",
    "test:integration:react-native": "npm --prefix integration/react-native-0.79 run validate && npm --prefix integration/react-native-0.87 run validate"
  },
  "version": "4.5.4"
}
